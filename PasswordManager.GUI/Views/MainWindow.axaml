<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="https://github.com/avaloniaui"
        xmlns:vm="clr-namespace:PasswordManager.GUI.ViewModels"
        x:Class="PasswordManager.GUI.MainWindow"
        x:DataType="vm:AuthViewModel"
        Title="Login / Register"
        Width="400" Height="300">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Welcome!" FontSize="24" HorizontalAlignment="Center"/>

        <TextBox Watermark="Username"
                 Text="{Binding Username, Mode=TwoWay}" />

        <TextBox Watermark="Password"
                 PasswordChar="•"
                 Text="{Binding Password, Mode=TwoWay}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Content="Login" Command="{Binding LoginCommand}" />
            <Button Content="Register" Command="{Binding RegisterCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Message}" Foreground="DarkRed" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
